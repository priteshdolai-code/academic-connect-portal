<head>
    <link rel="stylesheet" href="/css/style.css">
</head>
<nav>
    <a href="/home">Home</a>
    <a href="/about">About</a>
    <a href="/contact">Contact</a>
    <% if (user.role === 'admin') { %>
      <a href="/notice/new">Post Notice</a>
    <% } %>
    <% if (user.role === 'teacher') { %>
      <a href="/dashboard/teacher">Teacher Dashboard</a>
    <% } %>
    <% if (user.role === 'student') { %>
      <a href="/dashboard/student">Student Dashboard</a>
    <% } %>
    <a href="/notices">Notices</a>
    <a href="/logout">Logout</a>
  </nav>
  <hr>
  
<h2>Meeting History for <%= student.fullName %></h2>

<% if (meetings.length > 0) { %>
  <ul>
    <% meetings.forEach(meeting => { %>
      <li>
        <strong><%= meeting.date.toDateString() %>:</strong> <%= meeting.topic %><br>
        <em>By:</em> <%= meeting.teacher.fullName %><br>
        <p><%= meeting.notes %></p>
        <hr>
      </li>
    <% }) %>
  </ul>
<% } else { %>
  <p>No meetings logged yet.</p>
<% } %>
