<h2>Create Notice</h2>

<form method="POST" action="/notice/new">
  <label>Title:</label>
  <input type="text" name="title" required><br>

  <label>Message:</label>
  <textarea name="message" required></textarea><br>

  <button type="submit">Publish Notice</button>
</form>
