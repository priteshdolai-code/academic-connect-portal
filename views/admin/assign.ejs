<head>
    <link rel="stylesheet" href="/css/style.css">
</head>
<nav>
    <a href="/home">Home</a>
    <a href="/about">About</a>
    <a href="/contact">Contact</a>
    <% if (user.role === 'admin') { %>
      <a href="/notice/new">Post Notice</a>
    <% } %>
    <% if (user.role === 'teacher') { %>
      <a href="/dashboard/teacher">Teacher Dashboard</a>
    <% } %>
    <% if (user.role === 'student') { %>
      <a href="/dashboard/student">Student Dashboard</a>
    <% } %>
    <a href="/notices">Notices</a>
    <a href="/logout">Logout</a>
  </nav>
  <hr>
  
<h2>Assign Students to Teachers</h2>

<form method="POST" action="/admin/assign">
  <label for="studentId">Select Student:</label>
  <select name="studentId" required>
    <% students.forEach(student => { %>
      <option value="<%= student._id %>"><%= student.username %></option>
    <% }) %>
  </select>

  <label for="teacherId">Select Teacher:</label>
  <select name="teacherId" required>
    <% teachers.forEach(teacher => { %>
      <option value="<%= teacher._id %>"><%= teacher.username %></option>
    <% }) %>
  </select>

  <button type="submit">Assign</button>
</form>

<a href="/dashboard/admin">Back to Dashboard</a>
