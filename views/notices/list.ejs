<head>
    <link rel="stylesheet" href="/css/style.css">
</head>
<nav>
    <a href="/home">Home</a>
    <a href="/about">About</a>
    <a href="/contact">Contact</a>
    <% if (user.role === 'admin') { %>
      <a href="/notice/new">Post Notice</a>
    <% } %>
    <% if (user.role === 'teacher') { %>
      <a href="/dashboard/teacher">Teacher Dashboard</a>
    <% } %>
    <% if (user.role === 'student') { %>
      <a href="/dashboard/student">Student Dashboard</a>
    <% } %>
    <a href="/notices">Notices</a>
    <a href="/logout">Logout</a>
  </nav>
  <hr>
  
<h2>Latest Notices</h2>
<% if (notices.length > 0) { %>
  <ul>
    <% notices.forEach(notice => { %>
      <li>
        <strong><%= notice.title %></strong><br>
        <p><%= notice.message %></p>
        <small>Posted by <%= notice.createdBy.fullName %> (<%= notice.createdBy.role %>) on <%= notice.createdAt.toDateString() %></small>
        <hr>
      </li>
    <% }) %>
  </ul>
<% } else { %>
  <p>No notices posted yet.</p>
<% } %>
