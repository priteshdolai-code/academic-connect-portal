<head>
  <link rel="stylesheet" href="/css/style.css">
</head>
<nav>
  <a href="/home">Home</a>
  <a href="/about">About</a>
  <a href="/contact">Contact</a>
  <% if (user.role === 'admin') { %>
    <a href="/notice/new">Post Notice</a>
  <% } %>
  <% if (user.role === 'teacher') { %>
    <a href="/dashboard/teacher">Teacher Dashboard</a>
  <% } %>
  <% if (user.role === 'student') { %>
    <a href="/dashboard/student">Student Dashboard</a>
  <% } %>
  <a href="/notices">Notices</a>
  <a href="/logout">Logout</a>
  <a href="/profile">Profile</a>
</nav>
<hr>

<h2>Admin Dashboard</h2>
<p>Welcome, <%= user.username %></p>

<h3>All Users:</h3>
<table border="1">
  <tr>
    <th>Username</th><th>Role</th><th>Email</th>
  </tr>
  <% users.forEach(u => { %>
    <tr>
      <td>
        <% if (u.role === 'student') { %>
          <a href="/profile/<%= u._id %>"><%= u.username %></a>
         
        <% } else if (u.role === 'teacher') { %>
          <a href="/profile/<%= u._id %>"><%= u.username %></a>
        <% } else { %>
          <%= u.username %>
        <% } %>
      </td>
      <td><%= u.role %></td>
      <td><%= u.email %></td>
    </tr>
  <% }) %>
</table>

<a href="/logout">Logout</a>
