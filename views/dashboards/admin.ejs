<div class="dashboard-container">
  <h2>🛠️ Admin Dashboard</h2>
  <p>Welcome, <strong><%= user.username %></strong></p>

  <div style="margin: 20px 0;">
    <a href="/admin/assign" class="assign-button">➕ Assign Students</a>
  </div>

  <h3>All Users</h3>

  <div class="table-container">
    <table class="styled-table">
      <thead>
        <tr>
          <th>Username</th>
          <th>Role</th>
          <th>Email</th>
        </tr>
      </thead>
      <tbody>
        <% users.forEach(u => { %>
          <tr>
            <td>
              <% if (u.role === 'student' || u.role === 'teacher') { %>
                <a href="/profile/<%= u._id %>" class="profile-link"><%= u.username %></a>
              <% } else { %>
                <%= u.username %>
              <% } %>
            </td>
            <td>
              <span class="role-tag <%= u.role %>"><%= u.role.toUpperCase() %></span>
            </td>
            <td><%= u.email %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>



  <!-- FOOTER -->
  <footer class="footer">
    <p>&copy; <%= new Date().getFullYear() %> Academic Connect Portal. All rights reserved.</p>
  </footer>
</body>
