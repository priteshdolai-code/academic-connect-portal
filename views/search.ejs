<head>
  <link rel="stylesheet" href="/css/style.css">
</head>
<nav>
  <a href="/home">Home</a>
  <a href="/about">About</a>
  <a href="/contact">Contact</a>
  <% if (user.role === 'admin') { %>
    <a href="/notice/new">Post Notice</a>
  <% } %>
  <% if (user.role === 'teacher') { %>
    <a href="/dashboard/teacher">Teacher Dashboard</a>
  <% } %>
  <% if (user.role === 'student') { %>
    <a href="/dashboard/student">Student Dashboard</a>
  <% } %>
  <a href="/notices">Notices</a>
  <a href="/logout">Logout</a>
</nav>
<hr>

<h2>Search Students</h2>
<form method="GET" action="/search">
  <input type="text" name="q" value="<%= query %>" placeholder="Search by username or email" />
  <button type="submit">Search</button>
</form>

<ul>
  <% results.forEach(r => { %>
    <li><%= r.username %> - <%= r.email %></li>
  <% }) %>
</ul>
<a href="/dashboard/<%= user.role %>">Back to Dashboard</a>
