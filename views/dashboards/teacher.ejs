<head>
  <link rel="stylesheet" href="/css/style.css">
</head>
<nav>
  <a href="/home">Home</a>
  <a href="/about">About</a>
  <a href="/contact">Contact</a>
  <% if (user.role === 'admin') { %>
    <a href="/notice/new">Post Notice</a>
  <% } %>
  <% if (user.role === 'teacher') { %>
    <a href="/dashboard/teacher">Teacher Dashboard</a>
  <% } %>
  <% if (user.role === 'student') { %>
    <a href="/dashboard/student">Student Dashboard</a>
  <% } %>
  <a href="/notices">Notices</a>
  <a href="/profile">Profile</a>
  <a href="/logout">Logout</a>
</nav>
<hr>

<h2>Teacher Dashboard</h2>
<p>Welcome, <%= user.username %></p>

<h3>Your Assigned Students:</h3>

<% if (students.length > 0) { %>
  <table border="1">
    <thead>
      <tr>
        <th>Username</th>
        <th>Email</th>
        <th>View Profile</th>
        <th>Meeting</th>
      </tr>
    </thead>
    <tbody>
      <% students.forEach(student => { %>
        <tr>
          <td><%= student.username %></td>
          <td><%= student.email %></td>
          <td>
            <a href="/profile/<%= student._id %>">View Profile</a>
          </td>
          <td>
            <a href="/meeting/new/<%= student._id %>">Meeting</a>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } else { %>
  <p>No students assigned yet.</p>
<% } %>

<a href="/logout">Logout</a>
