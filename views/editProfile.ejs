<div class="login-container">
  <div class="login-card">
    <h2>Edit Profile</h2>

    <form method="POST" action="/profile/edit" class="login-form">
      <label for="fullName">Full Name</label>
      <input
        id="fullName"
        name="fullName"
        type="text"
        placeholder="Enter your full name"
        value="<%= user.fullName %>"
        required
      />

      <label for="email">Email</label>
      <input
        id="email"
        name="email"
        type="email"
        placeholder="Enter your email"
        value="<%= user.email %>"
        required
      />

      <label for="bio">Bio</label>
      <textarea
        id="bio"
        name="bio"
        placeholder="Write a short bio"
        rows="4"
      ><%= user.bio %></textarea>

      <button type="submit">Update Profile</button>
    </form>

    <div class="register-link">
      <a href="/profile">← Back to Profile</a>
    </div>
  </div>
</div>

 <!-- FOOTER -->
 <footer class="footer">
  <p>&copy; <%= new Date().getFullYear() %> Academic Connect Portal. All rights reserved.</p>
</footer>
</body>