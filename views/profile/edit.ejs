<head>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">
</head>

<body>
  <!-- HEADER NAVBAR -->
  <header>
    <nav class="navbar">
      <div class="nav-left">
        <a href="/home">
          <i class="fa-solid fa-graduation-cap"></i> <strong>Academic Connect</strong>
        </a>
      </div>

      <div class="nav-links">
        <a href="/home">Home</a>
        <a href="/about">About</a>
        <a href="/contact">Contact</a>
        <a href="/notices">Notices</a>

        <% if (user?.role === 'admin') { %>
          <a href="/notice/new">Post Notice</a>
        <% } %>

        <% if (user?.role === 'teacher') { %>
          <a href="/dashboard/teacher">Teacher Dashboard</a>
        <% } else if (user?.role === 'student') { %>
          <a href="/dashboard/student">Student Dashboard</a>
          <a href="/meetings/<%= user._id %>" >
            Meetings
          </a>
        <% } else if (user?.role === 'admin') { %>
          <a href="/dashboard/admin">Admin Dashboard</a>
        <% } %>

        <a href="/profile">Profile</a>
        <a href="/logout">Logout</a>
      </div>

      <% if (user && (user.role === 'admin' || user.role === 'teacher')) { %>
        <form class="nav-search" action="/search" method="GET">
          <input type="text" name="q" placeholder="Search students..." />
          <button type="submit"><i class="fa fa-search"></i></button>
        </form>
      <% } %>
      <% if (user?.role === 'teacher') { %>
        <a href="/issues" class="floating-button" title="Raise an Issue">
          📝 Issue
        </a>
      <% } else if (user?.role === 'student') { %>
        <a href="/issue/new" class="floating-button" title="Raise an Issue">
          📝 Raise Issue
        </a>
      <% } %>
      
    </nav>
  </header>
  <hr>
  
  <div class="edit-profile-container">
    <h2>📝 Edit Your Profile</h2>
  
    <form method="POST" action="/profile/<%= user._id %>/edit" class="edit-form">
      <label>Full Name:</label>
      <input type="text" name="fullName" value="<%= user.fullName %>" required>
  
      <label>Email:</label>
      <input type="email" name="email" value="<%= user.email %>" required>
  
      <label>Bio:</label>
      <textarea name="bio" rows="3"><%= user.bio %></textarea>
  
      <h3>🎓 Academic Info</h3>
  
      <label>Marks:</label>
      <input type="text" name="marks" value="<%= user.academic?.marks %>">
  
      <label>Attendance:</label>
      <input type="text" name="attendance" value="<%= user.academic?.attendance %>">
  
      <label>Extracurriculars:</label>
      <input type="text" name="extracurriculars" value="<%= user.academic?.extracurriculars %>">
  
      <div class="button-group">
        <button type="submit" class="save-btn">💾 Save Changes</button>
      </div>
      <div >
        <form action="/profile/<%= user._id %>" >
          <button type="submit" class="cancel-btn">❌ Cancel</button>
          </form>
      </div>
    </form>
  </div>
  
<!-- <a href="/profile/<%= user._id %>">Cancel</a> -->
