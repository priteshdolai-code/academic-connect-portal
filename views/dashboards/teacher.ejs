<div class="dashboard-container">
  <h2>👩‍🏫 Teacher Dashboard</h2>
  <p>Welcome, <strong><%= user.username %></strong></p>

  <h3>Your Assigned Students</h3>

  <% if (students.length > 0) { %>
    <div class="table-container">
      <table class="styled-table">
        <thead>
          <tr>
            <th>Username</th>
            <th>Email</th>
            <th>View Profile</th>
            <th>Meeting</th>
          </tr>
        </thead>
        <tbody>
          <% students.forEach(student => { %>
            <tr>
              <td><%= student.username %></td>
              <td><%= student.email %></td>
              <td><a href="/profile/<%= student._id %>" class="btn-view">🔍 View</a></td>
              <td><a href="/meeting/new/<%= student._id %>" class="btn-meeting">📅 Schedule</a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <p>No students assigned yet.</p>
  <% } %>
</div>

<a href="/issues" class="floating-button" title="Raise an Issue">
  📝 Issue
</a>

  <!-- FOOTER -->
  <footer class="footer">
    <p>&copy; <%= new Date().getFullYear() %> Academic Connect Portal. All rights reserved.</p>
  </footer>
</body>

