<head>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">
</head>

<body>
  <!-- HEADER NAVBAR -->
  <header>
    <nav class="navbar">
      <div class="nav-left">
        <a href="/home">
          <i class="fa-solid fa-graduation-cap"></i> <strong>Academic Connect</strong>
        </a>
      </div>

      <div class="nav-links">
        <a href="/home">Home</a>
        <a href="/about">About</a>
        <a href="/contact">Contact</a>
        <a href="/notices">Notices</a>

        <% if (user?.role === 'admin') { %>
          <a href="/notice/new">Post Notice</a>
        <% } %>

        <% if (user?.role === 'teacher') { %>
          <a href="/dashboard/teacher">Teacher Dashboard</a>
        <% } else if (user?.role === 'student') { %>
          <a href="/dashboard/student">Student Dashboard</a>
          <a href="/meetings/<%= user._id %>" >
            Meetings
          </a>
        <% } else if (user?.role === 'admin') { %>
          <a href="/dashboard/admin">Admin Dashboard</a>
        <% } %>

        <a href="/profile">Profile</a>
        <a href="/logout">Logout</a>
      </div>

      <% if (user && (user.role === 'admin' || user.role === 'teacher')) { %>
        <form class="nav-search" action="/search" method="GET">
          <input type="text" name="q" placeholder="Search students..." />
          <button type="submit"><i class="fa fa-search"></i></button>
        </form>
      <% } %>
      <% if (user?.role === 'teacher') { %>
        <a href="/issues" class="floating-button" title="Raise an Issue">
          📝 Issue
        </a>
      <% } else if (user?.role === 'student') { %>
        <a href="/issue/new" class="floating-button" title="Raise an Issue">
          📝 Raise Issue
        </a>
      <% } %>
      
    </nav>
  </header>
  <hr>
  
<h2>Meeting History for <%= student.fullName %></h2>

<% if (meetings.length > 0) { %>
  <ul>
    <% meetings.forEach(meeting => { %>
      <li>
        <strong><%= meeting.date.toDateString() %>:</strong> <%= meeting.topic %><br>
        <em>By:</em> <%= meeting.teacher.fullName %><br>
        <p><%= meeting.notes %></p>
        <hr>
      </li>
    <% }) %>
  </ul>
<% } else { %>
  <p>No meetings logged yet.</p>
<% } %>
