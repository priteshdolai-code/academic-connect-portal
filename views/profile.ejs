<head>
  <link rel="stylesheet" href="/css/style.css">
  <script src="https://kit.fontawesome.com/a2e0e6adcf.js" crossorigin="anonymous"></script>
</head>

<body>
  <header>
    <nav class="navbar">
      <div class="nav-left">
        <a href="/home">
          <i class="fa-solid fa-graduation-cap"></i> <strong>Academic Connect</strong>
        </a>
      </div>

      <div class="nav-links">
        <a href="/home">Home</a>
        <a href="/about">About</a>
        <a href="/contact">Contact</a>
        <a href="/notices">Notices</a>

        <% if (user?.role === 'admin') { %>
          <a href="/notice/new">Post Notice</a>
        <% } %>

        <% if (user?.role === 'teacher') { %>
          <a href="/dashboard/teacher">Teacher Dashboard</a>
        <% } else if (user?.role === 'student') { %>
          <a href="/dashboard/student">Student Dashboard</a>
        <% } else if (user?.role === 'admin') { %>
          <a href="/dashboard/admin">Admin Dashboard</a>
        <% } %>

        <a href="/profile">Profile</a>
        <a href="/logout">Logout</a>
      </div>

      <% if (user && (user.role === 'admin' || user.role === 'teacher')) { %>
        <form class="nav-search" action="/search" method="GET">
          <input type="text" name="q" placeholder="Search students..." />
          <button type="submit"><i class="fa fa-search"></i></button>
        </form>
      <% } %>
    </nav>
  </header>


  <div class="login-container">
    <div class="login-card" style="text-align: center;">
      <!-- Avatar -->
      <img src="https://i.pinimg.com/736x/05/26/44/052644db7472c37f710be66c22df005f.jpg" alt="Avatar" style="width: 100px; border-radius: 50%; margin-bottom: 15px;">

      <h2>Your Profile</h2>

      <!-- Role Badge -->
      <p>
        <strong>Role:</strong>
        <span class="badge badge-<%= user.role %>">
          <%= user.role.toUpperCase() %>
        </span>
      </p>
      
      
      

      <p><strong>Username:</strong> <%= user.username %></p>
      <p><strong>Full Name:</strong> <%= user.fullName || 'N/A' %></p>
      <p><strong>Email:</strong> <%= user.email || 'N/A' %></p>
      <p><strong>Bio:</strong> <%= user.bio || 'No bio added yet.' %></p>
      <p><strong>Last Updated:</strong> <%= new Date(user.updatedAt).toLocaleString() %></p>

      
      


      <!-- Buttons -->
      <div style="display: flex; justify-content: center; gap: 12px; flex-wrap: wrap; margin-top: 20px;">
        <form action="/profile/edit" method="get">
          <button type="submit">✏️ Edit Profile</button>
        </form>
        <% if (user?.role === 'student') { %>
          <form action="/profile/<%= user._id %>" method="get">
            <button type="submit">📝 View Academics</button>
          </form>
        <% } %>

        <form action="/profile/delete" onsubmit="return confirm('Are you sure you want to delete your profile?')">
          <button type="submit" style="background-color: #dc3545;">🗑️ Delete Profile</button>
        </form>
      </div>
    </div>
  </div>

  <!-- FOOTER -->
  <footer class="footer">
    <p>&copy; <%= new Date().getFullYear() %> Academic Connect Portal. All rights reserved.</p>
  </footer>
</body>
